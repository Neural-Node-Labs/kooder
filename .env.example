# Tip: you can skip this file — run: xcoder --config "provider=deepseek,key=<your-key>"
# (saved to ~/.xcoder/config.json; takes precedence over this file)

# Required
DEEPSEEK_API_KEY=sk-ant-...

# Optional
XCODER_MODEL=deepseek-v4-pro

# Optional — alternative OpenAI-compatible LLM providers (see docs/SETUP.md for the four role keys)
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=...
# OLLAMA_API_KEY=ollama

# Optional, only needed for github_create_repo / github_clone / github_commit / github_push
# GITHUB_TOKEN=ghp_...
XCODER_MAX_LINE_IN_FILE=500
# Optional: enable loading external skills from .agent/skill/<name>/SKILL.md
# (appended after the hardcoded role skills in the system prompt for all
# non-conversation roles). Set to 'true', '1', or 'yes' to enable.
# XCODER_EXTERNAL_SKILLS=true
# PROTOCOL_ERROR_LOG=true
# DEBUG_TOOLS=true
# Example credential ref for a ui_test/api_test subtask — Xcoder SDLC only ever
# receives the NAME "STAGING_PASSWORD", never the value below, as task input.
# STAGING_PASSWORD=...
