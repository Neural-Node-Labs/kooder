{
  "name": "kooder-cli",
  "version": "3.0.0",
  "description": "Kooder — a ReAct-driven worker-agent CLI. One worker orchestrator, one agent, a workspace index as the source of truth.",
  "type": "module",
  "bin": {
    "kooder": "./dist/cli-worker.js",
    "worker": "./dist/cli-worker.js"
  },
  "scripts": {
    "kooder:link": "npm link",
    "kooder:unlink": "npm unlink -g kooder-cli",
    "unlink": "npm unlink -g kooder-cli",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli-worker.ts",
    "start": "node dist/cli-worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:brand": "node scripts/check-brand-residue.mjs",
    "test": "npm run check:brand && vitest run",
    "regression": "npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@clack/prompts": "^0.7.0",
    "@types/js-yaml": "^4.0.9",
    "cheerio": "^1.2.0",
    "cli-spinners": "^2.9.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "js-yaml": "^5.2.2",
    "openai": "^7.4.0",
    "ora": "^8.1.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
